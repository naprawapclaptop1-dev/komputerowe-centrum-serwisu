<Window x:Class="NaprawaPCFanControlPro.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="NAPRAWA PC FAN CONTROL PRO AI"
 Width="1480" Height="940" MinWidth="1120" MinHeight="760"
 WindowStartupLocation="CenterScreen"
 Background="#07111F" Foreground="#E8F2FC"
 FontFamily="Segoe UI" FontSize="13"
 Loaded="OnLoaded" Closing="OnClosing">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#0E1D30" BorderBrush="#24415E" BorderThickness="0,0,0,1" Padding="22,12">
   <DockPanel>
    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
     <TextBlock Text="NAPRAWA PC  /  FAN CONTROL PRO AI" FontSize="22" FontWeight="Bold" Foreground="#EAF6FF"/>
     <TextBlock x:Name="MachineNameText" Text="Wykrywanie komputera…" Foreground="#8FA9C5" FontSize="12" Margin="1,3,0,0"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="RefreshButton" Content="ODŚWIEŻ" Click="OnRefreshClick" MinWidth="112"/>
     <Button Content="EKSPORT RAPORTU" Click="OnExportClick" MinWidth="150"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <TabControl Grid.Row="1" Margin="18,14,18,14" Background="#07111F" BorderBrush="#24415E">
   <TabItem Header="PULPIT">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="12">
      <TextBlock Text="MONITORING KOMPUTERA" FontSize="20" FontWeight="Bold" Foreground="#EAF6FF"/>
      <TextBlock Text="Rzeczywiste pomiary sprzętowe i status czujników" Foreground="#8FA9C5" Margin="0,4,0,15"/>
      <UniformGrid Columns="3" Rows="2">
       <Border Background="#102239" BorderBrush="#244763" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,12,12">
        <StackPanel><TextBlock Text="PROCESOR CPU" Foreground="#43D3F6" FontWeight="Bold"/><TextBlock x:Name="CpuValue" Text="—" FontSize="29" FontWeight="Bold" Margin="0,12,0,4"/><TextBlock x:Name="CpuDetail" Text="Oczekiwanie na czujnik" Foreground="#91A9C2"/></StackPanel>
       </Border>
       <Border Background="#102239" BorderBrush="#244763" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,12,12">
        <StackPanel><TextBlock Text="KARTA GRAFICZNA GPU" Foreground="#43D3F6" FontWeight="Bold"/><TextBlock x:Name="GpuValue" Text="—" FontSize="29" FontWeight="Bold" Margin="0,12,0,4"/><TextBlock x:Name="GpuDetail" Text="Oczekiwanie na czujnik" Foreground="#91A9C2"/></StackPanel>
       </Border>
       <Border Background="#102239" BorderBrush="#244763" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,12,12">
        <StackPanel><TextBlock Text="PAMIĘĆ RAM" Foreground="#43D3F6" FontWeight="Bold"/><TextBlock x:Name="RamValue" Text="—" FontSize="29" FontWeight="Bold" Margin="0,12,0,4"/><TextBlock x:Name="RamDetail" Text="Oczekiwanie na inwentaryzację" Foreground="#91A9C2"/></StackPanel>
       </Border>
       <Border Background="#102239" BorderBrush="#244763" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,12,12">
        <StackPanel><TextBlock Text="DYSKI" Foreground="#43D3F6" FontWeight="Bold"/><TextBlock x:Name="DiskValue" Text="—" FontSize="29" FontWeight="Bold" Margin="0,12,0,4"/><TextBlock Text="Dyski fizyczne wykryte przez system" Foreground="#91A9C2"/></StackPanel>
       </Border>
       <Border Background="#102239" BorderBrush="#244763" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,12,12">
        <StackPanel><TextBlock Text="WENTYLATORY" Foreground="#43D3F6" FontWeight="Bold"/><TextBlock x:Name="FanValue" Text="—" FontSize="29" FontWeight="Bold" Margin="0,12,0,4"/><TextBlock x:Name="FanDetail" Text="Kanały RPM" Foreground="#91A9C2"/></StackPanel>
       </Border>
       <Border Background="#102239" BorderBrush="#244763" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,12,12">
        <StackPanel><TextBlock Text="CZUJNIKI" Foreground="#43D3F6" FontWeight="Bold"/><TextBlock x:Name="SensorValue" Text="—" FontSize="29" FontWeight="Bold" Margin="0,12,0,4"/><TextBlock x:Name="SensorDetail" Text="Aktywne odczyty" Foreground="#91A9C2"/></StackPanel>
       </Border>
      </UniformGrid>
      <Border Background="#0D1B2D" BorderBrush="#24415E" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,3,0,8">
       <StackPanel><TextBlock Text="STATUS / OSTRZEŻENIA" Foreground="#43D3F6" FontWeight="Bold"/><TextBlock x:Name="DashboardStatus" Text="Start…" TextWrapping="Wrap" Foreground="#BDD0E4" Margin="0,8,0,0"/></StackPanel>
      </Border>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="CZUJNIKI LIVE">
    <DockPanel Margin="12">
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="ODCZYTY CZUJNIKÓW" FontSize="20" FontWeight="Bold" Foreground="#EAF6FF"/>
      <TextBlock Text="Odświeżanie co 2 sekundy. Brak urządzonego czujnika nie jest zastępowany wartością zerową." Foreground="#8FA9C5" Margin="0,4,0,7"/>
     </StackPanel>
     <DataGrid x:Name="SensorsGrid" ItemsSource="{Binding Sensors}">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Podzespół" Binding="{Binding HardwareName}" Width="220"/>
       <DataGridTextColumn Header="Typ urządzenia" Binding="{Binding HardwareType}" Width="140"/>
       <DataGridTextColumn Header="Czujnik" Binding="{Binding Name}" Width="*"/>
       <DataGridTextColumn Header="Rodzaj" Binding="{Binding Type}" Width="130"/>
       <DataGridTextColumn Header="Wartość" Binding="{Binding ValueText}" Width="130"/>
      </DataGrid.Columns>
     </DataGrid>
    </DockPanel>
   </TabItem>
   <TabItem Header="WENTYLATORY">
    <DockPanel Margin="12">
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="STEROWANIE WENTYLATORAMI" FontSize="20" FontWeight="Bold" Foreground="#EAF6FF"/>
      <TextBlock Text="Sterowanie jest dostępne wyłącznie, gdy kontroler zgłasza obsługiwany kanał IControl. Zmiana wymaga potwierdzenia." Foreground="#8FA9C5" TextWrapping="Wrap" Margin="0,4,0,10"/>
     </StackPanel>
     <Border DockPanel.Dock="Bottom" Background="#102239" BorderBrush="#244763" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,12,0,0">
      <StackPanel>
       <WrapPanel VerticalAlignment="Center">
        <TextBlock Text="Wybrany kanał:" Foreground="#BDD0E4" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBlock x:Name="SelectedFanText" Text="Nie wybrano" Foreground="#43D3F6" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
        <TextBlock Text="Ustawienie:" Foreground="#BDD0E4" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <Slider x:Name="FanSlider" Width="220" Minimum="0" Maximum="100" IsEnabled="False" VerticalAlignment="Center"/>
        <TextBlock x:Name="FanSliderValue" Text="—" Foreground="#EAF6FF" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,12,0"/>
        <Button Content="ZASTOSUJ" Click="OnApplyFanClick"/>
        <Button Content="TRYB DOMYŚLNY" Click="OnDefaultFanClick"/>
       </WrapPanel>
       <Separator Background="#244763" Margin="0,12,0,12"/>
       <WrapPanel>
        <TextBlock Text="Profil automatyczny:" Foreground="#BDD0E4" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox x:Name="ProfileCombo" Width="150" SelectedIndex="1" VerticalContentAlignment="Center">
         <ComboBoxItem Content="Cichy"/>
         <ComboBoxItem Content="Zrównoważony"/>
         <ComboBoxItem Content="Wydajny"/>
        </ComboBox>
        <Button x:Name="AutoButton" Content="WŁĄCZ AUTO" Click="OnAutoClick"/>
        <TextBlock x:Name="AutoStatus" Text="Automatyka wyłączona" Foreground="#91A9C2" VerticalAlignment="Center" Margin="12,0,0,0"/>
       </WrapPanel>
      </StackPanel>
     </Border>
     <DataGrid x:Name="FansGrid" ItemsSource="{Binding Fans}" SelectionChanged="OnFanSelectionChanged">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Urządzenie" Binding="{Binding HardwareName}" Width="220"/>
       <DataGridTextColumn Header="Wentylator" Binding="{Binding Name}" Width="*"/>
       <DataGridTextColumn Header="RPM" Binding="{Binding RpmText}" Width="120"/>
       <DataGridTextColumn Header="Sterowanie" Binding="{Binding ControlText}" Width="220"/>
      </DataGrid.Columns>
     </DataGrid>
    </DockPanel>
   </TabItem>
   <TabItem Header="INWENTARYZACJA">
    <DockPanel Margin="12">
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="INWENTARYZACJA SPRZĘTU" FontSize="20" FontWeight="Bold" Foreground="#EAF6FF"/>
      <TextBlock Text="WMI / SMBIOS / EDID — dokładność zależy od danych udostępnionych przez BIOS i sterowniki." Foreground="#8FA9C5" Margin="0,4,0,7"/>
     </StackPanel>
     <DataGrid x:Name="InventoryGrid" ItemsSource="{Binding Inventory}">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Kategoria" Binding="{Binding Category}" Width="150"/>
       <DataGridTextColumn Header="Komponent / slot" Binding="{Binding Component}" Width="220"/>
       <DataGridTextColumn Header="Szczegóły" Binding="{Binding Details}" Width="*"/>
       <DataGridTextColumn Header="Źródło" Binding="{Binding Source}" Width="155"/>
      </DataGrid.Columns>
     </DataGrid>
    </DockPanel>
   </TabItem>
  </TabControl>
  <Border Grid.Row="2" Background="#0D1B2B" BorderBrush="#203B55" BorderThickness="0,1,0,0" Padding="12,5">
   <DockPanel>
    <TextBlock x:Name="StatusText" Text="Gotowy" Foreground="#91A9C2" VerticalAlignment="Center"/>
    <TextBlock Text="FIX001  |  WINDOWS 10/11  |  x64" Foreground="#43D3F6" HorizontalAlignment="Right" VerticalAlignment="Center"/>
   </DockPanel>
  </Border>
 </Grid>
</Window>
