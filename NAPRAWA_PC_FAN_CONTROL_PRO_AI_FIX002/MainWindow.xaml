<Window x:Class="NaprawaPCFanControl.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NAPRAWA PC FAN CONTROL PRO AI 2.0.5" Width="1460" Height="920" MinWidth="1120" MinHeight="720" WindowStartupLocation="CenterScreen" Background="#07111F" Closing="Window_Closing">
<Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Grid.Row="0" Background="#101E30" CornerRadius="18" Padding="22" BorderBrush="#263B52" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<StackPanel Orientation="Horizontal"><Border Width="54" Height="54" CornerRadius="15" Background="#123B50" Margin="0,0,15,0"><TextBlock Text="❄" FontSize="30" Foreground="#22D3EE" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="NAPRAWA PC  /  FAN CONTROL PRO AI" FontSize="21" FontWeight="Bold"/><TextBlock Text="CENTRUM MONITORINGU I KONTROLI CHŁODZENIA  •  2.0.5  •  FIX007" Foreground="#91A7BE" FontSize="11" Margin="0,5,0,0"/></StackPanel></StackPanel>
<StackPanel Grid.Column="1" VerticalAlignment="Center"><Border Background="#123B32" BorderBrush="#1D755B" BorderThickness="1" CornerRadius="10" Padding="12,7"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#43E0A0" Margin="0,0,8,0"/><TextBlock x:Name="StatusText" Text="INICJALIZACJA" Foreground="#9FF0C9" FontWeight="SemiBold" FontSize="11"/></StackPanel></Border><TextBlock x:Name="LastUpdateText" Text="Oczekiwanie na czujniki..." Foreground="#91A7BE" FontSize="10" HorizontalAlignment="Right" Margin="0,7,0,0"/></StackPanel>
</Grid></Border>
<Grid Grid.Row="1" Margin="0,16,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Grid.Column="0" Background="#101E30" CornerRadius="14" Padding="16" Margin="0,0,8,0"><StackPanel><TextBlock Text="CPU • TEMPERATURA" Foreground="#91A7BE" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="CpuTempText" Text="-- °C" FontSize="27" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock x:Name="CpuLoadText" Text="Obciążenie: --" Foreground="#22D3EE" FontSize="11"/></StackPanel></Border>
<Border Grid.Column="1" Background="#101E30" CornerRadius="14" Padding="16" Margin="4,0"><StackPanel><TextBlock Text="GPU • TEMPERATURA" Foreground="#91A7BE" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="GpuTempText" Text="-- °C" FontSize="27" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock x:Name="GpuLoadText" Text="Obciążenie: --" Foreground="#22D3EE" FontSize="11"/></StackPanel></Border>
<Border Grid.Column="2" Background="#101E30" CornerRadius="14" Padding="16" Margin="4,0"><StackPanel><TextBlock Text="CPU • ZEGAR" Foreground="#91A7BE" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="CpuClockText" Text="-- MHz" FontSize="27" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock x:Name="CpuPowerText" Text="Moc: --" Foreground="#22D3EE" FontSize="11"/></StackPanel></Border>
<Border Grid.Column="3" Background="#101E30" CornerRadius="14" Padding="16" Margin="8,0,0,0"><StackPanel><TextBlock Text="KANAŁY WENTYLATORÓW" Foreground="#91A7BE" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="FanCountText" Text="0" FontSize="27" FontWeight="Bold" Margin="0,7,0,0"/><TextBlock x:Name="FanModeText" Text="Wykrywanie kanałów..." Foreground="#22D3EE" FontSize="11"/></StackPanel></Border>
</Grid>
<TabControl Grid.Row="2" Background="#101E30" BorderBrush="#263B52" Padding="8">
<TabItem Header="PULPIT"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#0C1929" CornerRadius="14" Padding="18" Margin="0,0,10,0"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="0,0,0,14"><TextBlock Text="Podgląd czujników na żywo" FontSize="17" FontWeight="Bold"/><TextBlock Text="Odczyty aktualizowane automatycznie co 2 sekundy." Foreground="#91A7BE" FontSize="11" Margin="0,4,0,0"/></StackPanel>
<DataGrid x:Name="DashboardSensors" ItemsSource="{Binding Sensors}" AlternationCount="2"><DataGrid.Columns><DataGridTextColumn Header="TYP" Binding="{Binding Category}" Width="100"/><DataGridTextColumn Header="CZUJNIK" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="URZĄDZENIE" Binding="{Binding Hardware}" Width="190"/><DataGridTextColumn Header="WARTOŚĆ" Binding="{Binding Value}" Width="115"/></DataGrid.Columns></DataGrid></DockPanel></Border>
<StackPanel Grid.Column="1"><Border Background="#0C1929" CornerRadius="14" Padding="18" Margin="0,0,0,10"><StackPanel><TextBlock Text="Szybkie działania" FontSize="17" FontWeight="Bold" Margin="0,0,0,12"/><Button Content="ODŚWIEŻ CZUJNIKI" Click="Refresh_Click" HorizontalAlignment="Stretch"/><Button Content="SKANUJ SPRZĘT" Click="Inventory_Click" Background="#A5B4FC" HorizontalAlignment="Stretch"/><Button Content="ZAPISZ RAPORT SERWISOWY" Click="Report_Click" Background="#34D399" HorizontalAlignment="Stretch"/></StackPanel></Border>
<Border Background="#0C1929" CornerRadius="14" Padding="18"><StackPanel><TextBlock Text="Informacje o sterowaniu" FontSize="17" FontWeight="Bold"/><TextBlock Text="Program pokazuje tylko kanały udostępnione przez kontroler sprzętowy. Nie każdy laptop, BIOS ani kontroler płyty głównej pozwala zmieniać obroty z poziomu Windows." TextWrapping="Wrap" Foreground="#A9C1D8" FontSize="12" Margin="0,10,0,0"/><TextBlock x:Name="WarningText" Text="Oczekiwanie na pomiar temperatur." TextWrapping="Wrap" Foreground="#FBBF24" FontWeight="SemiBold" Margin="0,14,0,0"/></StackPanel></Border></StackPanel>
</Grid></TabItem>
<TabItem Header="WENTYLATORY"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Background="#0C1929" CornerRadius="14" Padding="18" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Sterowanie chłodzeniem" FontSize="18" FontWeight="Bold"/><TextBlock Text="Profile automatyczne albo ręczne sterowanie kanałami wykrytymi przez sterownik." Foreground="#91A7BE" FontSize="11" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><ComboBox x:Name="ModeCombo" Width="190" Height="34" SelectedIndex="0" SelectionChanged="ModeCombo_SelectionChanged"><ComboBoxItem Content="Automatyczny • Zrównoważony"/><ComboBoxItem Content="Cichy"/><ComboBoxItem Content="Wydajny"/><ComboBoxItem Content="Ręczny"/><ComboBoxItem Content="Domyślne sterownika"/></ComboBox><Button Content="PRZYWRÓĆ DOMYŚLNE" Click="Restore_Click" Background="#FBBF24"/></StackPanel></Grid></Border>
<Border Grid.Row="1" Background="#0C1929" CornerRadius="14" Padding="18"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Wykryte kanały sterowania" FontWeight="Bold" FontSize="15" Margin="0,0,0,12"/><DataGrid x:Name="FanGrid" ItemsSource="{Binding Fans}"><DataGrid.Columns><DataGridTextColumn Header="KONTROLER" Binding="{Binding Hardware}" Width="210"/><DataGridTextColumn Header="KANAŁ" Binding="{Binding Name}" Width="220"/><DataGridTemplateColumn Header="USTAWIENIE (0–100%)" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Slider Minimum="20" Maximum="100" TickFrequency="5" Value="{Binding Percent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanControl}" Margin="8,3"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="PROCENT" Binding="{Binding Percent, StringFormat={}{0:0}%}" Width="85"/></DataGrid.Columns></DataGrid></DockPanel></Border>
<TextBlock Grid.Row="2" Text="Bez wykrytego kanału sterowania aplikacja nie wymusza obrotów. Ustawienia domyślne są przywracane przy zamknięciu." Foreground="#91A7BE" TextWrapping="Wrap" FontSize="11" Margin="4,12,4,0"/>
</Grid></TabItem>
<TabItem Header="INWENTARYZACJA"><Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,12"><StackPanel DockPanel.Dock="Left"><TextBlock Text="Pełny przegląd komputera" FontSize="18" FontWeight="Bold"/><TextBlock Text="WMI / SMBIOS / EDID — zakres danych zależy od firmware i sterowników." Foreground="#91A7BE" FontSize="11" Margin="0,4,0,0"/></StackPanel><Button DockPanel.Dock="Right" Content="SKANUJ PONOWNIE" Click="Inventory_Click"/></DockPanel><DataGrid Grid.Row="1" x:Name="InventoryGrid" ItemsSource="{Binding Inventory}"><DataGrid.Columns><DataGridTextColumn Header="SEKCJA" Binding="{Binding Section}" Width="170"/><DataGridTextColumn Header="ELEMENT" Binding="{Binding Component}" Width="210"/><DataGridTextColumn Header="WARTOŚĆ" Binding="{Binding Value}" Width="*"/><DataGridTextColumn Header="SZCZEGÓŁY" Binding="{Binding Details}" Width="260"/></DataGrid.Columns></DataGrid></Grid></TabItem>
</TabControl>
<DockPanel Grid.Row="3" Margin="4,12,4,0"><TextBlock Text="NAPRAWA PC • FAN CONTROL PRO AI 2.0.5 FIX007" Foreground="#607B96" FontSize="10" DockPanel.Dock="Left"/><TextBlock x:Name="FooterText" Text="Gotowy" Foreground="#91A7BE" FontSize="10" DockPanel.Dock="Right"/></DockPanel>
</Grid></Window>